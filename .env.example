# Discord
DISCORD_TOKEN=여기에_봇_토큰
ALLOWED_GUILD_IDS=서버ID

# 밍보드 연동
MINGBOARD_API_URL=
MINGBOARD_BOSS_API_URL=
MINGBOARD_HEARTBEAT_API_URL=
MINGBOT_API_SECRET=

# Google Sheets 연동을 사용할 경우 서버의 실제 경로
GOOGLE_CREDENTIALS_FILE=/etc/simbangbot/google-credentials.json

# 서버 DB 위치
SIMBANGBOT_DB_PATH=/var/lib/simbangbot/simbangbot.db
